<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/recipe_filters_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/search_filters_title"
        app:navigationIcon="@drawable/ic_report_back"
        app:navigationContentDescription="@string/report_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/recipe_filters_toolbar_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp"
            android:orientation="vertical"
            android:focusableInTouchMode="true">
            <TextView
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/search_dish"
                android:labelFor="@id/recipe_filter_dish" />
            <Spinner
                android:id="@+id/recipe_filter_dish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="@string/search_dish" />
            <TextView
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/search_diet"
                android:labelFor="@id/recipe_filter_diet" />
            <Spinner
                android:id="@+id/recipe_filter_diet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="@string/search_diet" />
            <TextView
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/search_meal"
                android:labelFor="@id/recipe_filter_meal" />
            <Spinner
                android:id="@+id/recipe_filter_meal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="@string/search_meal" />
            <TextView
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/search_method"
                android:labelFor="@id/recipe_filter_method" />
            <Spinner
                android:id="@+id/recipe_filter_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="@string/search_method" />
            <TextView
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/search_prep_time" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/recipe_filter_min_time_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/search_min_time">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recipe_filter_min_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>
                <Spinner
                    android:id="@+id/recipe_filter_min_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minHeight="48dp"
                    android:contentDescription="@string/search_min_unit" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/recipe_filter_max_time_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/search_max_time">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recipe_filter_max_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>
                <Spinner
                    android:id="@+id/recipe_filter_max_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minHeight="48dp"
                    android:contentDescription="@string/search_max_unit" />
            </LinearLayout>
            <TextView
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/search_exclude_allergens" />
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/recipe_filter_gluten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/search_allergen_gluten" />
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/recipe_filter_milk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/search_allergen_milk" />
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/recipe_filter_eggs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/search_allergen_egg" />
            <TextView
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/search_ingredients"
                android:labelFor="@id/recipe_filter_ingredients_source" />
            <Spinner
                android:id="@+id/recipe_filter_ingredients_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="@string/search_ingredients" />
            <TextView
                android:id="@+id/recipe_filter_pantry_summary"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/recipe_filter_manual_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/recipe_filter_ingredient_query_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/search_find_ingredient">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recipe_filter_ingredient_query"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/recipe_filter_ingredient_count"
                    style="@style/AppTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:id="@+id/recipe_filter_ingredient_empty"
                    style="@style/AppTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/search_no_ingredients"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/recipe_filter_ingredient_choices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/recipe_filter_max_missing_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:helperText="@string/search_max_missing_hint"
                android:hint="@string/search_max_missing"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recipe_filter_max_missing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:singleLine="true"
                    android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recipe_filters_apply"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/search_apply" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recipe_filters_clear"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/search_clear" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
