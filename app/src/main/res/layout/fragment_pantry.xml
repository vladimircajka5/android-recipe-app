<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        style="@style/AppTitle" android:text="@string/pantry_title" android:accessibilityHeading="true" />
    <TextView android:id="@+id/pantry_notice" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/AppTextSecondary" />
    <EditText android:id="@+id/pantry_filter" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp"
        android:hint="@string/pantry_search_hint" android:inputType="text" android:imeOptions="actionDone"
        android:singleLine="true" android:importantForAutofill="no" style="@style/AppEditText" />
    <com.google.android.material.button.MaterialButton android:id="@+id/pantry_add"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" style="@style/PrimaryButton" android:text="@string/pantry_add_title" />
    <TextView android:id="@+id/pantry_message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center"
        style="@style/AppText" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <ListView android:id="@+id/pantry_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"
        android:divider="@color/app_outline" android:dividerHeight="1dp" android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
