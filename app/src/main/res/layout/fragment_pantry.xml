<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <include layout="@layout/pantry_controls" />
    <TextView android:id="@+id/pantry_message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center"
        style="@style/AppText" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <ListView android:id="@+id/pantry_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"
        android:divider="@color/app_outline" android:dividerHeight="1dp" android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
