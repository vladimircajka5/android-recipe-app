<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.camera.view.PreviewView android:id="@+id/barcode_preview" android:layout_width="0dp" android:layout_height="0dp"
        app:implementationMode="compatible" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="20dp" android:background="@color/app_surface" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/barcode_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" style="@style/AppText" />
        <EditText android:id="@+id/barcode_manual_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/barcode_manual_hint" android:inputType="number" android:singleLine="true" style="@style/AppEditText" />
        <com.google.android.material.button.MaterialButton android:id="@+id/barcode_manual_continue" android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/PrimaryButton" android:text="@string/barcode_manual_continue" />
        <com.google.android.material.button.MaterialButton android:id="@+id/barcode_cancel" android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/SecondaryButton" android:text="@string/pantry_cancel" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
