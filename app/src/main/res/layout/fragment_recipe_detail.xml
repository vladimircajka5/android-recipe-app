<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.recipe.RecipeDetailFragment">

    <View
        android:id="@+id/view_recipe_detail_circle_1"
        android:layout_width="222dp"
        android:layout_height="208dp"
        android:alpha="0.25"
        android:background="@drawable/bg_circle"
        android:translationX="-60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.074" />

    <View
        android:id="@+id/view_recipe_detail_circle_2"
        android:layout_width="203dp"
        android:layout_height="200dp"
        android:alpha="0.15"
        android:background="@drawable/bg_circle"
        android:translationX="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.444" />

    <View
        android:id="@+id/view_recipe_detail_circle_3"
        android:layout_width="153dp"
        android:layout_height="156dp"
        android:alpha="0.3"
        android:background="@drawable/bg_circle"
        android:translationX="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <View
        android:id="@+id/view_recipe_detail_circle_4"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:alpha="0.15"
        android:background="@drawable/bg_circle"
        android:translationX="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.051"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.657" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="24dp">

            <TextView
                android:id="@+id/tv_recipe_detail_title"
                style="@style/AppTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recipe_detail_title" />

            <ImageView
                android:id="@+id/iv_recipe_detail_photo"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/recipe_detail_photo_description"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <TextView
                android:id="@+id/tv_recipe_detail_name"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                tools:text="Homemade Pasta" />

            <TextView
                android:id="@+id/tv_recipe_detail_author"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="By username" />

            <TextView
                android:id="@+id/tv_recipe_detail_region"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="Region: Vojvodina" />

            <TextView
                android:id="@+id/tv_recipe_detail_duration"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="Preparation time: 45 min" />

            <TextView
                android:id="@+id/tv_recipe_detail_original"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="Based on an original recipe" />

            <TextView
                android:id="@+id/tv_recipe_detail_servings_title"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/recipe_detail_servings_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_recipe_detail_decrease"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recipe_detail_decrease"
                    android:contentDescription="@string/recipe_detail_decrease_description" />

                <TextView
                    android:id="@+id/tv_recipe_detail_servings"
                    style="@style/AppText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="center"
                    tools:text="4 servings" />

                <Button
                    android:id="@+id/btn_recipe_detail_increase"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recipe_detail_increase"
                    android:contentDescription="@string/recipe_detail_increase_description" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_recipe_detail_ingredients_title"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/recipe_detail_ingredients_title" />

            <LinearLayout
                android:id="@+id/ll_recipe_detail_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_recipe_detail_ingredients_preview"
                    style="@style/AppText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="250 g pasta&#10;2 tomatoes&#10;100 g cheese&#10;1 tbsp olive oil" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_recipe_detail_allergens"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="Allergens: gluten, milk" />

            <TextView
                android:id="@+id/tv_recipe_detail_steps_title"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/recipe_detail_steps_title" />

            <LinearLayout
                android:id="@+id/ll_recipe_detail_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_recipe_detail_steps_preview"
                    style="@style/AppText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="1. Prepare the ingredients&#10;&#10;2. Cook the pasta&#10;&#10;3. Add the sauce and serve" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_recipe_detail_cook"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/recipe_detail_cook" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_recipe_detail_favorite"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/recipe_detail_favorite" />

                <Button
                    android:id="@+id/btn_recipe_detail_modify"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/recipe_detail_modify" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_recipe_detail_manage_title"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/recipe_detail_manage_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_recipe_detail_edit"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/recipe_detail_edit" />

                <Button
                    android:id="@+id/btn_recipe_detail_delete"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/recipe_detail_delete" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
