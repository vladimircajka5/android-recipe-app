<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/report_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/report_detail_title"
        app:navigationIcon="@drawable/ic_report_back"
        app:navigationContentDescription="@string/report_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">
            <TextView
                android:id="@+id/report_detail_notice"
                style="@style/AppTextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/report_preview_notice" />
            <TextView
                android:id="@+id/report_detail_status"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/report_status_new" />
            <TextView
                android:id="@+id/report_detail_type"
                style="@style/AppTextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/report_type_recipe" />
            <TextView
                android:id="@+id/report_detail_title"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/report_sample_recipe" />
            <ImageView
                android:id="@+id/report_detail_photo"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/report_photo_description"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <TextView
                android:id="@+id/report_detail_content"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/report_sample_recipe_content" />
            <TextView
                android:id="@+id/report_reporter_label"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/report_reporter_label" />
            <TextView
                android:id="@+id/report_detail_reporter"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_sample_self" />
            <TextView
                android:id="@+id/report_date_label"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/report_date_label" />
            <TextView
                android:id="@+id/report_detail_date"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_sample_date_new" />
            <TextView
                android:id="@+id/report_reason_label"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/report_reason_label" />
            <TextView
                android:id="@+id/report_detail_reason"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_sample_reason_recipe" />
            <LinearLayout
                android:id="@+id/report_decision_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView
                android:id="@+id/report_decision_label"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/report_decision_label" />
            <TextView
                android:id="@+id/report_detail_decision"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_sample_accepted" />
            <TextView
                android:id="@+id/report_resolved_label"
                style="@style/AppSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/report_resolved_label" />
            <TextView
                android:id="@+id/report_detail_resolved"
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_sample_date_resolved" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_withdraw"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/report_withdraw" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_accept"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/report_accept" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_reject"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/report_reject" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_remove"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/report_remove" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
