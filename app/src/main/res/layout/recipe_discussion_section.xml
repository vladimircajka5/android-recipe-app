<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    android:orientation="vertical">

    <TextView
        style="@style/AppSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/recipe_discussion_title" />

    <TextView
        style="@style/AppTextSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:labelFor="@id/recipe_comment_sort"
        android:text="@string/recipe_comment_sort" />

    <Spinner
        android:id="@+id/recipe_comment_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:entries="@array/recipe_comment_sort_options" />

    <TextView
        android:id="@+id/recipe_discussion_empty"
        style="@style/AppTextSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/recipe_discussion_empty" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recipe_comment_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        tools:listitem="@layout/item_recipe_comment" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recipe_add_comment"
        style="@style/SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/recipe_comment_action" />
</LinearLayout>
