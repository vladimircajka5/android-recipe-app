<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/AppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/proposal_title" />

    <TextView
        style="@style/AppTextSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/proposal_preview_notice" />

    <TextView
        android:id="@+id/tv_proposals_access"
        style="@style/AppTextSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/proposal_checking_role" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/spinner_proposal_scope"
                android:text="@string/proposal_scope" />

            <Spinner
                android:id="@+id/spinner_proposal_scope"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/AppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/spinner_proposal_status"
                android:text="@string/proposal_filter" />

            <Spinner
                android:id="@+id/spinner_proposal_status"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_proposal_new"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/proposal_new" />

    <TextView
        android:id="@+id/tv_proposals_empty"
        style="@style/AppTextSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:text="@string/proposal_empty"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list_proposals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>