<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/shopping_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/AppTitle" android:accessibilityHeading="true"/>
    <TextView android:id="@+id/shopping_detail_progress" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/AppTextSecondary"/>
    <TextView android:text="@string/shopping_temporary_notice" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/AppTextSecondary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_add_item" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:layout_height="wrap_content" android:text="@string/shopping_add_item" style="@style/PrimaryButton"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_edit_list" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:layout_height="wrap_content" android:text="@string/shopping_edit_list" style="@style/SecondaryButton"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_mark_all" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:layout_height="wrap_content" android:text="@string/shopping_mark_all" style="@style/SecondaryButton"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_delete_list" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:layout_height="wrap_content" android:text="@string/shopping_delete_list" style="@style/SecondaryButton"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/shopping_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shopping_back" style="@style/Widget.Material3.Button.TextButton"/>
</LinearLayout>
