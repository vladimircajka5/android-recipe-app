<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/shopping_list_picker_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:visibility="gone"
        app:navigationContentDescription="@string/report_back"
        app:navigationIcon="@drawable/ic_report_back"
        app:title="@string/recipe_shopping_choose_list" />
    <TextView android:id="@+id/shopping_lists_title" android:text="@string/shopping_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/AppTitle" android:accessibilityHeading="true"/>
    <TextView android:id="@+id/shopping_lists_notice" android:text="@string/shopping_demo_notice" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/AppTextSecondary" android:layout_marginTop="8dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/shopping_new_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shopping_new_list" style="@style/PrimaryButton"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/shopping_toggle_archived" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shopping_show_archived" style="@style/SecondaryButton"/>
</LinearLayout>
