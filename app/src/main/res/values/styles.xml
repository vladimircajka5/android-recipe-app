<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== BUTTONS ==================== -->

    <!-- Primary actions: Login, Register, Save... -->
    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/app_on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Secondary actions: Back, Create account... -->
    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/app_surface</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/app_primary</item>
        <item name="strokeWidth">2dp</item>
    </style>


    <!-- ==================== TEXT ==================== -->

    <!-- Screen Title -->
    <style name="AppTitle">
        <item name="android:textColor">@color/app_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Screen Subtitle -->
    <style name="AppSubtitle">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Regular Text -->
    <style name="AppText">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Less Important Text -->
    <style name="AppTextSecondary">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>


    <!-- ==================== INPUT FIELDS ==================== -->

    <!-- Text inside an input field -->
    <style name="AppEditText">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textColorHint">@color/app_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Material outlined input container -->
    <style name="AppInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/app_surface</item>

        <!-- Border -->
        <item name="boxStrokeColor">@color/app_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <!-- Label -->
        <item name="hintTextColor">@color/app_text</item>
        <item name="android:textColorHint">@color/app_text</item>

        <!-- Rounded corners -->
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>

    </style>

    <!-- Recipe Card -->
    <style name="RecipeCard">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RecipeCardImage">
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">?attr/colorSurfaceVariant</item>
    </style>

    <style name="RecipeCardTextContainer">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">start</item>
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="RecipeCardTitle" parent="AppTitle">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">7dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="RecipeCardDescription" parent="AppText">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="RecipeCardFavoriteButton">
        <item name="android:background">@drawable/ic_recipe_favorite_background</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_margin">14dp</item>
        <item name="android:src">@drawable/ic_recipe_favorite_outline</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="AppBottomBar" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/navigation_bar_background</item>
    </style>

    <!-- User Recipes -->
    <style name="UserRecipesAvatar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

</resources>
