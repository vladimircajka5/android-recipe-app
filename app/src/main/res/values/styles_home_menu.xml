<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="HomeMenuItem"
        parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">3</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/app_primary</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

</resources>