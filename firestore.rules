
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Pomocne funkcije =====

    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "ADMIN";
    }


    // ===== Administratorske uloge =====

    match /roles/{userId} {

      // Korisnik cita svoju ulogu, admin moze i tudju
      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow list: if false;

      // Samo admin dodeljuje ulogu drugom korisniku
      allow create: if isAdmin()
        && request.auth.uid != userId
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasOnly(["role"])
        && request.resource.data.role == "ADMIN";

      // Uloge se ne menjaju i ne brisu iz aplikacije
      allow update, delete: if false;
    }


    // ===== Ostali korisnicki podaci =====

    match /users/{userId}/pantry/{itemId} {
      allow read, write: if ownsUserData(userId);
    }

    match /users/{userId}/shoppingLists/{listId} {
      allow read, write: if ownsUserData(userId);
    }

    match /users/{userId}/shoppingItems/{itemId} {
      allow read, write: if ownsUserData(userId);
    }


    // ===== Korisnicki profili =====

    match /users/{userId} {

      // Prijavljeni korisnici mogu da vide tudje profile
      allow get: if signedIn();

      // Zabranjeno listanje svih korisnika
      allow list: if false;

      // Kreiranje sopstvenog profila pri registraciji
      allow create: if ownsUserData(userId)
        && request.resource.data.uid == userId;

      // Vlasnik menja samo dozvoljena polja profila
      allow update: if ownsUserData(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'biography',
            'country',
            'region',
            'city',
            'latitude',
            'longitude',
            'profileImageUrl',
            'updatedAt'
          ]);

      // Brisanje profila nije dozvoljeno iz aplikacije
      allow delete: if false;
    }


    // ===== Korisnicka imena =====

    match /usernames/{username} {

      // Citanje pojedinacnog username dokumenta
      allow get: if true;

      // Zabranjen pregled cele kolekcije
      allow list: if false;

      // Rezervacija korisnickog imena pri registraciji
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      // Korisnicko ime se ne menja i ne brise
      allow update, delete: if false;
    }

  }
}
