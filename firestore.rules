rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "ADMIN";
    }

    
  match /roles/{userId} {

  allow get: if signedIn() && (request.auth.uid == userId || isAdmin());

  allow list: if false;

  // Samo admin dodeljuje ADMIN ulogu drugom korisniku
  allow create: if isAdmin()
    && request.auth.uid != userId
    && exists(/databases/$(database)/documents/users/$(userId))
    && request.resource.data.keys().hasOnly(["role"])
    && request.resource.data.role == "ADMIN";

  // Nema proizvoljne promene i brisanja uloga
  allow update, delete: if false;
  }

    match /users/{userId}/pantry/{itemId} {
      allow read, write: if ownsUserData(userId);
    }

    match /users/{userId}/shoppingLists/{listId} {
      allow read, write: if ownsUserData(userId);
    }

    match /users/{userId}/shoppingItems/{itemId} {
      allow read, write: if ownsUserData(userId);
    }

    match /users/{userId} {
      allow read, write: if ownsUserData(userId);
    }

    
    match /usernames/{username} {

        // Dozvoljeno citanje pojedinacnog korisnickog imena
        allow get: if true;

        // Zabranjen pregled cele kolekcije
        allow list: if false;

        // Kreiranje rezervacije za sopstveni nalog
        allow create: if signedIn()
            && !exists(/databases/$(database)/documents/usernames/$(username))
            && request.resource.data.keys().hasOnly(['uid', 'email'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email;

        // Korisnicko ime se ne menja i ne brise
        allow update, delete: if false;
    }

  }
}